# =============================================================================
# EasyControl API — variáveis de ambiente. Copie para `.env` (dev) ou `api.env` (Docker).
# NUNCA commitar o arquivo preenchido (está no .gitignore).
#
# Os nomes são os MESMOS do EasyControl atual (deploy/app.env.example) — o cofre (Infisical,
# projetos `easycontrol` e `easycontrol-homolog`) é o mesmo. Validação em src/config/env.ts:
# variável obrigatória ausente ou inválida = a API NÃO sobe (fail-fast).
# =============================================================================

# ---- Processo ---------------------------------------------------------------
NODE_ENV=development
PORT=3030
API_PREFIX=api/v1
HTTP_BODY_LIMIT=1mb
# Swagger em /<API_PREFIX>/docs. Desligue se a API ficar exposta à internet.
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=300

# ---- Log (lidas direto pelo logger) ----------------------------------------
LOG_LEVEL=info
LOG_FORMAT=text

# ---- CORS -------------------------------------------------------------------
# VAZIO = fechado (o padrão): quem chama esta API é o servidor do Next.
CORS_ORIGIN=

# ---- Supabase (OBRIGATÓRIAS) ------------------------------------------------
# produção: nyoqadtohcgiwrbhoqdo · homologação: ltixkslqlreybdhutpbr
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# service_role: ignora a RLS. Só pelo ServiceRole (exclusão de usuário, eventos PIX).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Stripe (opcionais: sem elas, só a sincronização de preços falha) -------
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=

# ---- EasyERP-API (Webhooks PIX) ---------------------------------------------
# Era VITE_PIX_WEBHOOK_API_URL (embutida no navegador). Vazia = a de produção.
# homologação: https://webhook-easyerp-hom.easysoftcloud.com.br/api/v1
PIX_WEBHOOK_API_URL=
