# Lidas SÓ no servidor do Next (nunca vão ao navegador). Nenhum segredo aqui: Supabase, Stripe e
# EasyERP-API vivem só na API (api/).

# Endereço da API NestJS do EasyControl (sem barra final). As rotas ficam em /api/v1.
EASYCONTROL_API_URL=http://127.0.0.1:3030

# "true" em HTTPS (produção). Padrão: true quando NODE_ENV=production.
SESSION_COOKIE_SECURE=false
